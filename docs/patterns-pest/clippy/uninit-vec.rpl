pattern uninit-vec

patt {
    use std::vec::Vec;

    #[diag = "uninit_vec"]
    #[const(msg = "calling `set_len()` immediately after reserving a buffer creates uninitialized values")]
    #[deduplicate]
    with_capacity[$T: type, $vec: place(Vec<$T>)] =
        with_capacity_any[$T = $T, $vec = $vec]
        - with_capacity_zero[$T = $T, $vec = $vec]

    #[diag = "uninit_vec"]
    #[const(msg = "calling `set_len()` immediately after reserving a buffer creates uninitialized values")]
    #[deduplicate]
    assign_with_capacity[$T: type, $vec: place(Vec<$T>)] =
        assign_with_capacity_any[$T = $T, $vec = $vec]
        - assign_with_capacity_zero[$T = $T, $vec = $vec]

    #[diag = "uninit_vec"]
    #[const(msg = "calling `set_len()` immediately after reserving a buffer creates uninitialized values")]
    #[deduplicate]
    reserve[$T: type, $vec: place(Vec<$T>)] =
        reserve_any[$T = $T, $vec = $vec]
        - reserve_zero[$T = $T, $vec = $vec]

    #[diag = "uninit_vec"]
    #[const(msg = "calling `set_len()` on empty `Vec` creates out-of-bound values")]
    #[deduplicate]
    new[$T: type, $vec: place(Vec<$T>)] =
        new_any[$T = $T, $vec = $vec]
        - new_zero[$T = $T, $vec = $vec]

    #[diag = "uninit_vec"]
    #[const(msg = "calling `set_len()` on empty `Vec` creates out-of-bound values")]
    #[deduplicate]
    default_default[$T: type, $vec: place(Vec<$T>)] =
        default_default_any[$T = $T, $vec = $vec]
        - default_default_zero[$T = $T, $vec = $vec]
}

util {
    use std::vec::Vec;
    use std::default::Default;

    with_capacity_any[$T: type where !can_be_uninit(self), $vec: place(Vec<$T>)] = unsafe? fn _(..) -> _ {
        let $vec_ref: &mut Vec<$T>;

        'reserve:
        $vec = Vec::with_capacity(_);
        $vec_ref = &mut $vec;
        'set_len:
        _ = Vec::set_len(move $vec_ref, _);
    }

    with_capacity_zero[$T: type where !can_be_uninit(self), $vec: place(Vec<$T>)] = unsafe? fn _(..) -> _ {
        let $vec_ref: &mut Vec<$T>;

        'reserve:
        $vec = Vec::with_capacity(_);
        $vec_ref = &mut $vec;
        'set_len:
        _ = Vec::set_len(move $vec_ref, const 0usize);
    }

    assign_with_capacity_any[$T: type where !can_be_uninit(self), $vec: place(Vec<$T>)] = unsafe? fn _(..) -> _ {
        let $vec_ref: &mut Vec<$T>;
        let $new_vec: Vec<$T>;

        $new_vec = Vec::with_capacity(_);
        'reserve:
        $vec = move $new_vec;
        $vec_ref = &mut $vec;
        'set_len:
        _ = Vec::set_len(move $vec_ref, _);
    }

    assign_with_capacity_zero[$T: type where !can_be_uninit(self), $vec: place(Vec<$T>)] = unsafe? fn _(..) -> _ {
        let $vec_ref: &mut Vec<$T>;
        let $new_vec: Vec<$T>;

        $new_vec = Vec::with_capacity(_);
        'reserve:
        $vec = move $new_vec;
        $vec_ref = &mut $vec;
        'set_len:
        _ = Vec::set_len(move $vec_ref, const 0usize);
    }

    reserve_any[$T: type where !can_be_uninit(self), $vec: place(Vec<$T>)] = unsafe? fn _(..) -> _ {
        let $vec_ref_1: &mut Vec<$T>;
        let $vec_ref_2: &mut Vec<$T>;

        $vec_ref_1 = &mut $vec;
        'reserve:
        _ = Vec::reserve(move $vec_ref_1, _);
        $vec_ref_2 = &mut $vec;
        'set_len:
        _ = Vec::set_len(move $vec_ref_2, _);
    }

    reserve_zero[$T: type where !can_be_uninit(self), $vec: place(Vec<$T>)] = unsafe? fn _(..) -> _ {
        let $vec_ref_1: &mut Vec<$T>;
        let $vec_ref_2: &mut Vec<$T>;

        $vec_ref_1 = &mut $vec;
        'reserve:
        _ = Vec::reserve(move $vec_ref_1, _);
        $vec_ref_2 = &mut $vec;
        'set_len:
        _ = Vec::set_len(move $vec_ref_2, const 0usize);
    }

    new_any[$T: type where !can_be_uninit(self), $vec: place(Vec<$T>)] = unsafe? fn _(..) -> _ {
        let $vec_ref: &mut Vec<$T>;

        'reserve:
        $vec = Vec::new();
        $vec_ref = &mut $vec;
        'set_len:
        _ = Vec::set_len(move $vec_ref, _);
    }

    new_zero[$T: type where !can_be_uninit(self), $vec: place(Vec<$T>)] = unsafe? fn _(..) -> _ {
        let $vec_ref: &mut Vec<$T>;

        'reserve:
        $vec = Vec::new();
        $vec_ref = &mut $vec;
        'set_len:
        _ = Vec::set_len(move $vec_ref, const 0usize);
    }

    default_default_any[$T: type where !can_be_uninit(self), $vec: place(Vec<$T>)] = unsafe? fn _(..) -> _ {
        let $vec_ref: &mut Vec<$T>;

        'reserve:
        $vec = Default::default();
        $vec_ref = &mut $vec;
        'set_len:
        _ = Vec::set_len(move $vec_ref, _);
    }

    default_default_zero[$T: type where !can_be_uninit(self), $vec: place(Vec<$T>)] = unsafe? fn _(..) -> _ {
        let $vec_ref: &mut Vec<$T>;

        'reserve:
        $vec = Default::default();
        $vec_ref = &mut $vec;
        'set_len:
        _ = Vec::set_len(move $vec_ref, const 0usize);
    }
}

diag {
    uninit_vec = {
        primary(reserve, set_len) = "{$msg}",
        help                      = "initialize the buffer or wrap the content in `MaybeUninit`",
        name                      = "uninit_vec",
    }
}
